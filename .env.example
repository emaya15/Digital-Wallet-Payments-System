# Copy to .env and fill in. Never commit real secrets.
APP_ENV=development
DATABASE_URL=mysql+pymysql://wallet_user:wallet_password@localhost:3306/digital_wallet
TEST_DATABASE_URL=mysql+pymysql://wallet_user:wallet_password@localhost:3306/digital_wallet_test
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
BCRYPT_ROUNDS=12

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@digitalwallet.local

# Razorpay TEST mode keys only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SCHEDULER_ENABLED=true
STATEMENTS_DIR=statements
